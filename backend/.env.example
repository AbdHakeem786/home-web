PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/restmenu_home

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# OTP (mocked for now — no real SMS provider wired up)
OTP_EXPIRES_MIN=5

# Web push (generate with: node -e "console.log(require('web-push').generateVAPIDKeys())")
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Email (registration verification link) - leave blank to log the link to
# the console instead of sending. Fill in a Gmail address + App Password
# (myaccount.google.com/apppasswords) to send real emails.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=RestMenu Home <no-reply@example.com>
FRONTEND_URL=http://localhost:5173

# Google Sign-In (Client ID only - no secret needed for ID-token verification)
GOOGLE_CLIENT_ID=

# The only email allowed to become an admin (auto-promoted to role "admin" on Google Sign-In)
ADMIN_EMAIL=

# Stripe (card payments) - get test keys from https://dashboard.stripe.com/test/apikeys
# and run `stripe listen --forward-to localhost:5000/api/webhooks/stripe` locally to get
# a webhook secret for STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=sk_test_replace_with_your_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_secret_from_stripe_listen

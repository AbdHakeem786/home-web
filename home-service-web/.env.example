# Base URL of the backend API (see ../backend)
VITE_API_BASE_URL=http://localhost:5000/api

# Google Sign-In Client ID (public - matches backend/.env GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Stripe publishable key (public - matches backend/.env STRIPE_SECRET_KEY's account)
VITE_STRIPE_PUBLISHABLE_KEY=